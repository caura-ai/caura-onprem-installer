#!/usr/bin/env bash
# Serve the canonical fixture only when the checker requests the exact hardened source URL.
set -euo pipefail

EXPECTED_URL=https://raw.githubusercontent.com/caura-ai/caura/main/scripts/legacy_name_ratchet.py
url=
out=
saw_fail=false
saw_location=false
saw_retry=false
saw_https_only=false
saw_tls=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --fail) saw_fail=true; shift ;;
    --silent | --show-error) shift ;;
    --location) saw_location=true; shift ;;
    --retry)
      [ "${2:-}" = 3 ] || { echo "stub curl: retry count is not 3" >&2; exit 64; }
      saw_retry=true
      shift 2
      ;;
    --proto)
      [ "${2:-}" = '=https' ] || { echo "stub curl: protocol is not HTTPS-only" >&2; exit 64; }
      saw_https_only=true
      shift 2
      ;;
    --tlsv1.2) saw_tls=true; shift ;;
    -o)
      out=${2:-}
      shift 2
      ;;
    -*) echo "stub curl: unexpected option: $1" >&2; exit 64 ;;
    *)
      [ -z "$url" ] || { echo "stub curl: multiple URLs" >&2; exit 64; }
      url=$1
      shift
      ;;
  esac
done

[ "$url" = "$EXPECTED_URL" ] || { echo "stub curl: unexpected URL: $url" >&2; exit 64; }
[ -n "$out" ] || { echo "stub curl: output path is missing" >&2; exit 64; }
[ "$saw_fail" = true ] || { echo "stub curl: --fail is missing" >&2; exit 64; }
[ "$saw_location" = true ] || { echo "stub curl: --location is missing" >&2; exit 64; }
[ "$saw_retry" = true ] || { echo "stub curl: --retry is missing" >&2; exit 64; }
[ "$saw_https_only" = true ] || { echo "stub curl: --proto '=https' is missing" >&2; exit 64; }
[ "$saw_tls" = true ] || { echo "stub curl: --tlsv1.2 is missing" >&2; exit 64; }

fixture=${RATCHET_PARITY_FIXTURE:?stub curl needs RATCHET_PARITY_FIXTURE}/legacy_name_ratchet.py
[ -f "$fixture" ] || exit 22
cp "$fixture" "$out"

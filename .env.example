# Caura Enterprise on-prem — consolidated env template.
#
# Copy to .env and fill in required values. The installer generates
# sensible defaults for anything left blank.

# ────────── Required secrets ──────────
# 32+ chars. install.sh generates if blank.
JWT_SECRET=
# install.sh generates if blank.
POSTGRES_PASSWORD=
# install.sh generates if blank.
CORE_ADMIN_API_KEY=

# ────────── Database ──────────
# Default: the bundled `postgres` service in docker-compose.yml (pgvector/pg16).
# To use YOUR OWN Postgres instead (managed RDS / Cloud SQL / AlloyDB / a
# central cluster), set POSTGRES_HOST to its address and fill in the
# credentials below. The bundled `postgres` service then goes unused — you
# can comment it out of docker-compose.yml (and its `depends_on: postgres`
# entries) if you don't want it running.
#
# REQUIREMENT for an external instance: the `vector` (pgvector) extension
# must be installed/enabled on the target database — Caura stores 1024-dim
# embeddings as pgvector columns and migrations run CREATE EXTENSION vector.
# Managed Postgres (RDS, Cloud SQL, AlloyDB, Azure) all support it but it
# must be enabled, and the DB user needs CREATE privileges for migrations.
# blank = bundled service; else your DB host
POSTGRES_HOST=
# blank = 5432
POSTGRES_PORT=
# The role and database an existing install already owns its data under, so
# these defaults are permanent: both fall back to `memclaw` when left blank.  (legacy-name-floor: the on-prem Postgres defaults, which are floor)
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_REQUIRE_SSL=false             # true to require TLS to an external DB
# Fernet key (base64 url-safe, 44 chars). REQUIRED when core-api runs in
# ENVIRONMENT=production (which all on-prem deployments do). install.sh
# auto-generates with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SETTINGS_ENCRYPTION_KEY=

# Gateway header-trust perimeter (OSS caura#802). Shared by the gateway and the
# services it injects identity headers into (core-api, platform-admin-api).
# REQUIRED in production from backend-2.28.0. install.sh generates it on a fresh
# install; upgrade.sh backfills it. 64 hex chars; generated if left blank.
GATEWAY_SHARED_SECRET=

# Storage-auth perimeter for the core-api -> core-storage-api hop. REQUIRED —
# core-api will not start without it from backend-2.46.0. install.sh generates it
# on a fresh install; upgrade.sh backfills it. 64 hex chars; generated if blank.
CORE_STORAGE_SHARED_SECRET=

# ────────── Required config ──────────
# CAURA_VERSION and CAURA_OPS_VERSION are the current spellings. Each also has
# an older name that is a permanent alias and keeps working — an existing .env
# needs no change. Whichever name holds a NON-EMPTY value wins, so leaving one
# of a pair blank never blanks the setting. Both spellings: docs/env-aliases.md.
PUBLIC_HOSTNAME=caura.acme.com         # customer domain; must match TLS cert CN
CAURA_VERSION=v2.8.4                   # pin to a release tag (do not use :latest)
# scheduler/worker image tag; blank = CAURA_VERSION. Set explicitly only for a phased ops rollout ahead of the core stack.
CAURA_OPS_VERSION=

# ────────── LLM / embedding ──────────
# Connected deployments: provide your own OpenAI / Anthropic / Vertex keys.
# Air-gapped deployments: set EMBEDDING_PROVIDER=local and leave keys empty.
EMBEDDING_PROVIDER=local               # local | openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ENTITY_EXTRACTION_PROVIDER=none        # none | openai | anthropic | gemini
USE_LLM_FOR_MEMORY_CREATION=false

# Reserved-agent-id write policy: allow | warn | reject.
# "main" is the unset-plugin-default identity; misconfigured clients that write
# with it collapse every install into one shared "firehose" bucket. reject
# refuses those writes (409) so they must self-identify; warn logs + proceeds;
# allow disables the guard. Reads/recall are unaffected. Set reject to harden.
RESERVED_AGENT_ID_POLICY=warn

# Platform-tier fallback (optional, for Vertex/managed LLMs)
PLATFORM_LLM_PROVIDER=
PLATFORM_LLM_MODEL=
PLATFORM_LLM_API_KEY=
PLATFORM_EMBEDDING_PROVIDER=
PLATFORM_EMBEDDING_MODEL=
PLATFORM_EMBEDDING_API_KEY=

# ────────── Email ──────────
# `log` writes emails to stdout — fine for air-gap. Switch to smtp / sendgrid
# / resend when you want real outbound mail (password resets, invites).
EMAIL_PROVIDER=log                     # log | sendgrid | resend | smtp
EMAIL_API_KEY=
# defaults to noreply@<PUBLIC_HOSTNAME>
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587

# ────────── OAuth (optional — leave blank to hide GitHub login) ──────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ────────── Disabled on-prem (do not modify) ──────────
# Billing is permanently off in on-prem builds. License drives enforcement.
# BILLING_ENABLED=false (set in docker-compose.yml — do NOT override here)

# ────────── Internal ──────────
SCHEDULER_ENABLED=false                # security-audit cron; single-replica only
SKIP_EMAIL_VERIFICATION=true           # on-prem default; set false ONLY if you've wired a real mailer above
